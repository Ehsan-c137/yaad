# ==========================================
# Yaad Self-Hosting Configuration
# ==========================================

# Public Port for the Web App & API
PORT=8080

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
POSTGRES_DB=yaad

# JWT Secret for User Authentication (generate a secure random 32+ character string)
JWT_SECRET=replace_with_a_random_jwt_secret_key_1234567890

# Optional: External API or WebSocket URL overrides (if hosting behind custom reverse proxies)
# VITE_API_URL=https://your-domain.com
# VITE_WS_URL=wss://your-domain.com/collab
