{
   "compilerOptions": {
      "target": "ES2020",
      "useDefineForClassFields": true,
      "lib": ["ES2020", "DOM"],
      "module": "ESNext",
      "skipLibCheck": true,
      "allowJs": true,

      /* Bundler mode */
      "moduleResolution": "bundler",
      "allowImportingTsExtensions": true,
      "resolveJsonModule": true,
      "isolatedModules": true,
      "noEmit": true,
      "jsx": "react-jsx",

      /* Path Aliases */
      "paths": {
         "@/*": ["./src/*"],
         "@ui/*": ["./src/components/ui/*"]
      },

      /* Linting */
      "strict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noFallthroughCasesInSwitch": true
   },
   "include": [
      "src",
      "vite.config.ts",
      "eslint.config.mjs",
      "prettier.config.mjs"
   ],
   "references": [{ "path": "./tsconfig.node.json" }]
}
